# API Information


main: {
  kit: {
    info: {
      contact: {
        email: "support@figma.com"
      }
      description: `This is the OpenAPI specification for the [Figma REST API](https://developers.figma.com/docs/rest-api/).

Note: we are releasing the OpenAPI specification as a beta given the large surface area and complexity of the REST API. If you notice any inaccuracies with the specification, please [file an issue](https://github.com/figma/rest-api-spec/issues).`
      security: {
        alternatives: [
          [
            {
              in: "header"
              name: "X-Figma-Token"
              prefix: ""
              scheme: "PlanAccessToken"
              type: "apiKey"
            }
          ]
          [
            {
              in: "header"
              name: "Authorization"
              prefix: "Bearer"
              scheme: "OrgOAuth2"
              type: "oauth2"
            }
          ]
          [
            {
              in: "header"
              name: "Authorization"
              prefix: "Bearer"
              scheme: "OAuth2"
              type: "oauth2"
            }
          ]
        ]
        in: "header"
        name: "X-Figma-Token"
        prefix: ""
        scheme: "PersonalAccessToken"
        type: "apiKey"
      }
      servers: [
        {
          url: "https://api.figma.com"
        }
      ]
      summary: "This is the OpenAPI specification for the [Figma REST API](https://developers.figma.com/docs/rest-api/)."
      termsOfService: "https://www.figma.com/developer-terms/"
      title: "Figma API"
      version: "0.45.0"
      website: "https://developers.figma.com/docs/rest-api/"
    }
  }
}

