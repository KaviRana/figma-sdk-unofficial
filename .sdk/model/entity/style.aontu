            ]
          }
          r: {
            param: {
              key: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "styles"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.meta`"
          }
        }
        {
          co: {
            id: "GET /v1/teams/{team_id}/styles"
            source: "openapi3"
